{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexSwitcher",
  "version": "0.1.46",
  "identifier": "local.codex.account-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodexSwitcher",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "cmscloud",
    "resources": {
      "easytier/third_party/x86_64/": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5N0MyMTdGQkVGOUI3RkUKUldUK3QvbStmeUY4R1NyMmttS09JbFJjTHo2T1NwakRxVjBZUGRFVW04WnJyY0xhbXVqanF2SzcK",
      "endpoints": [
        "https://github.com/doit9816/codex-account-switcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
